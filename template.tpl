scenarios:
- name: First visit sets denied defaults, the EEA backstop and loads the snippet
  code: |-
    runCode(mockData);
    assertApi('setDefaultConsentState').wasCalledWith({
      ad_storage: 'denied',
      ad_user_data: 'denied',
      ad_personalization: 'denied',
      analytics_storage: 'denied',
      functionality_storage: 'denied',
      personalization_storage: 'denied',
      security_storage: 'granted',
      wait_for_update: 500
    });
    assertApi('setDefaultConsentState').wasCalledWith({
      ad_storage: 'denied',
      ad_user_data: 'denied',
      ad_personalization: 'denied',
      analytics_storage: 'denied',
      region: EEA,
      wait_for_update: 500
    });
    assertApi('updateConsentState').wasNotCalled();
    assertApi('injectScript').wasCalled();
    assertThat(injectedUrl).isEqualTo('https://cdn.venividicookie.com/s/abc123def456ghi7.js');
    assertApi('gtmOnSuccess').wasCalled();
- name: Never grants anything by default
  code: |-
    runCode(mockData);
    assertApi('setDefaultConsentState').wasNotCalledWith({
      ad_storage: 'granted',
      ad_user_data: 'denied',
      ad_personalization: 'denied',
      analytics_storage: 'denied',
      functionality_storage: 'denied',
      personalization_storage: 'denied',
      security_storage: 'granted',
      wait_for_update: 500
    });
    assertThat(defaults.length).isEqualTo(2);
    const types = ['ad_storage', 'ad_user_data', 'ad_personalization', 'analytics_storage',
      'functionality_storage', 'personalization_storage'];
    for (let i = 0; i < types.length; i++) {
      assertThat(defaults[0][types[i]]).isEqualTo('denied');
    }
    for (let i = 0; i < 4; i++) {
      assertThat(defaults[1][types[i]]).isEqualTo('denied');
    }
    assertThat(defaults[0].security_storage).isEqualTo('granted');
    assertThat(defaults[1].security_storage).isUndefined();
- name: By default a stored choice is not applied by the tag (H2)
  code: |-
    cookieValue = COOKIES.acceptAll;
    mockData.applyStoredChoice = undefined;
    runCode(mockData);
    assertApi('updateConsentState').wasNotCalled();
    assertApi('injectScript').wasCalled();
